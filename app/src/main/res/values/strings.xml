    <string name="about_title">ABOUT</string>
    <string name="about_description">A minimalist chain-reaction puzzle game. One tap starts the impulse; timing and placement decide how far the reaction travels.</string>
    <string name="about_copyright">© 2026 Stanley Lloyd. All rights reserved.</string>
    <string name="back">Back</string>
    <string name="game_hint">Tap once to start a chain reaction</string>
    <string name="tutorial_title">LEARN THE IMPULSE</string>
    <string name="tutorial_level_1">Tap once. Your only impulse starts the reaction.</string>
    <string name="tutorial_level_2">Triggered particles create new waves. Choose the moment that links the biggest group.</string>
    <string name="tutorial_level_3">Reach the target to pass. Trigger more particles for 2 stars, or every particle for 3.</string>
    <string name="mechanic_title">NEW CHALLENGE</string>
    <string name="mechanic_booster">Pink Boosters emit a larger wave when triggered.</string>
    <string name="mechanic_fuse">Gold Fuses pause briefly before their reaction wave expands.</string>
    <string name="mechanic_anchor">Blue Anchors stay fixed, giving the chain reliable relay points.</string>
    <string name="mechanic_mix">Boosters, Fuses, and Anchors now share the field. Use their reach, timing, and fixed positions together.</string>
    <string name="content_resonance">Resonance fields are denser. Read the whole board and use special particles as one connected system.</string>
    <string name="content_chaos">Chaos pushes every mechanic at once. Look for the single opening that turns a crowded field into one long reaction.</string>
